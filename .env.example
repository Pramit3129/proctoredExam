# Postgres shared with the LMS. The app reads public.users (sign-in) and writes only to the `proctor` schema.
# Prefer a least-privilege role (see db/least-privilege.sql) over the postgres superuser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional: verify the database TLS certificate. PEM text or a file path
# (Supabase: Project Settings → Database → SSL certificate). Without it the
# connection is encrypted but the server is not authenticated.
# DATABASE_CA_CERT=./certs/supabase-ca.crt

# Optional: DATABASE_SSL=disable for a local Postgres without TLS. Never in production.
# DATABASE_SSL=disable

# Optional: max pooled connections (the database is shared with the LMS). Default 5.
# DATABASE_POOL_MAX=5

# Signs the exam-attempt cookie. Required in production (32+ random characters).
#   openssl rand -hex 32
PROCTOR_SECRET=

# LMS roles (public.users.role) allowed into /admin. Default: admin
# PROCTOR_ADMIN_ROLES=admin

# Optional: only let users with a verified email (public.users.email_verified_at) sign in.
# PROCTOR_REQUIRE_VERIFIED_EMAIL=1

# Optional: set to 1 when running behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Host.
# PROCTOR_TRUST_PROXY=1

# Optional: extra origins allowed to call the API, comma separated.
# PROCTOR_ALLOWED_ORIGINS=https://exam.example.com

# Optional: allow non-Secure cookies when running a production build over plain http (local testing only).
# PROCTOR_INSECURE_COOKIES=1
